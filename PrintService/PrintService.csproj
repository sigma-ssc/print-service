<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>org.sigma.services.PrintService</AssemblyName>
    <RootNamespace>org.sigma.services.PrintService</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <AssemblyVersion>1</AssemblyVersion>
    <FileVersion>1.0.1</FileVersion>
    <Version>1.0.1</Version>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Remove/hide files: -->
  <ItemGroup>
    <None Remove="*.vspscc" />
    <None Remove="Logs\**" />
    <None Remove="Printjobs\**" />
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="Ghostscript.NativeAssets" Version="10.8.2" />
    <PackageReference Include="Ghostscript.NET" Version="1.3.8" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="11.0.0" />
  </ItemGroup>

    <!--
    Workaround: Ghostscript.NativeAssets adds Content items for BOTH win-x86 and win-x64 (flattened into the
    output root via <Link>), regardless of RuntimeIdentifier. This causes duplicate publish paths
    (e.g. ghostscript.version). We only target win-x64, so drop the x86 items.
    Must be a target because the package's .targets file is imported after this project body.
    -->
    <Target Name="RemoveGhostscriptWinX86Content" BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems;ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <_GsX86Content Include="@(Content)" Condition="$([System.String]::Copy('%(FullPath)').Replace('/', '\').ToLowerInvariant().Contains('ghostscript.nativeassets\')) And $([System.String]::Copy('%(FullPath)').Replace('/', '\').ToLowerInvariant().Contains('\runtimes\win-x86\'))" />
            <Content Remove="@(_GsX86Content)" />
        </ItemGroup>
    </Target>
  
  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
  </PropertyGroup>

</Project>
