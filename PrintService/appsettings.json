{
  "AllowedHosts": "*",
  "Ghostscript": {
    "Parameter": [
      "-empty",
      "-dPrinted",
      "-dBATCH",
      "-dNOPAUSE",
      "-dNoCancel",
      "-dNOSAFER",
      "-dNumCopies=1",
      "-dFIXEDMEDIA",
      "-dPDFFitPage",
      "-sDEVICE=mswinpr2"
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Debug", "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      // Global minimum Log Level (set to lowest level 'Verbose' so you can define the Log Level for each Logger/Sink)
      "Default": "Verbose", // [Verbose < Debug < Information < Warning < Error < Fatal < None=6]
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },

    // Add sinks
    "WriteTo": [
      // Debug Window:
      {
        "Name": "Debug",
        "Args": {
          "restrictedToMinimumLevel": "Debug",
          "outputTemplate": "[{Level:u3}] {Message:j} {Scope:j} <{SourceContext}>{NewLine}{Exception}"
        }
      },

      // Console:
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console", // [Literate(Standard) | Code | Sixteen | Grayscale]
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}>{NewLine}{Exception}"
        }
      },

      // FILE "General.log":
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "path": "./Logs/SIGMA_PrintService.log",
          "fileSizeLimitBytes": 10000000,
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext}: {Message:j} {Properties}{NewLine}{Exception}"
        }
      },

      // FILE "Detailed.log":
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "path": "./Logs/SIGMA_PrintService.Detailed_.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 1,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] (TID:{ThreadId}) {SourceContext}: {Message:j} {Properties}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
